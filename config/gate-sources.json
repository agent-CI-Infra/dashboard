{
  "windowDays": 7,
  "sources": [
    {
      "id": "sciencediscovery",
      "name": "sciencediscovery",
      "owner": "openJiuwen-ai",
      "defaultBranch": "main",
      "type": "actions-api",
      "url": "https://sciencediscovery.github.io/github-status-board/data/snapshot.json",
      "dashboardUrl": "https://sciencediscovery.github.io/github-status-board/#overview",
      "categoryMap": {
        "build": {
          "channel": [
            "gate"
          ],
          "event": [
            "push"
          ]
        },
        "ready": {
          "channel": [
            "gate"
          ],
          "event": [
            "pull_request"
          ],
          "scope": "repo",
          "line": "main"
        },
        "merge": {
          "channel": [
            "gate"
          ],
          "event": [
            "merge_group"
          ]
        },
        "daily": {
          "channel": [
            "daily"
          ]
        },
        "release": {
          "channel": [
            "release"
          ],
          "scope": "repo",
          "line": "releases/v0.3.0.beta"
        }
      },
      "channelMap": [
        {
          "channel": "gate",
          "workflow": [
            "CI"
          ]
        },
        {
          "channel": "daily",
          "workflow": [
            "Nightly"
          ]
        },
        {
          "channel": "release",
          "workflow": [
            "Release"
          ]
        }
      ],
      "snapshotUrl": "https://sciencediscovery.github.io/github-status-board/data/snapshot.json",
      "coverage": {
        "artifacts": [
          "node-coverage-summary",
          "python-coverage-summary"
        ],
        "languageByArtifact": {
          "node-coverage-summary": "node",
          "python-coverage-summary": "python"
        },
        "summaryPaths": [
          "summary.json",
          "coverage/summary.json",
          "python/summary.json"
        ]
      },
      "branchLines": {
        "main": "主干",
        "releases/v0.3.0.beta": "发布线"
      }
    }
  ]
}