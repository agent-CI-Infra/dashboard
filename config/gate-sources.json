{
  "windowDays": 30,
  "sources": [
    {
      "id": "sciencediscovery",
      "name": "sciencediscovery",
      "owner": "openJiuwen-ai",
      "defaultBranch": "main",
      "type": "status-board-lanes",
      "url": "https://sciencediscovery.github.io/github-status-board/data/snapshot.json",
      "dashboardUrl": "https://sciencediscovery.github.io/github-status-board/#overview",
      "channelMap": [
        {
          "channel": "gate",
          "workflow": [
            "CI"
          ]
        },
        {
          "channel": "daily",
          "workflow": [
            "Nightly"
          ]
        },
        {
          "channel": "release",
          "workflow": [
            "Release"
          ]
        }
      ],
      "snapshotUrl": "https://sciencediscovery.github.io/github-status-board/data/snapshot.json",
      "coverage": {
        "artifacts": [
          "node-coverage-summary",
          "python-coverage-summary"
        ],
        "languageByArtifact": {
          "node-coverage-summary": "node",
          "python-coverage-summary": "python"
        },
        "summaryPaths": [
          "summary.json",
          "coverage/summary.json",
          "python/summary.json"
        ]
      },
      "branchLines": {
        "main": "主干",
        "releases/v0.3.0.beta": "发布线"
      },
      "boardBaseUrl": "https://sciencediscovery.github.io/github-status-board/",
      "coverageTab": "coverage",
      "caseLayers": [
        {
          "name": "L1",
          "artifacts": [
            "l1-results"
          ],
          "summaries": [
            "l1/tagged/summary.json"
          ]
        },
        {
          "name": "UT",
          "artifacts": [
            "ut-results"
          ],
          "summaries": [
            "ut/tagged/group-*/summary.json"
          ]
        },
        {
          "name": "ST",
          "artifacts": [
            "st-results"
          ],
          "summaries": [
            "st/tagged/group-*/summary.json"
          ]
        },
        {
          "name": "E2E (mocked)",
          "artifacts": [
            "mocked-e2e-plan"
          ],
          "summaries": [
            "plan.json"
          ],
          "planOnly": true
        },
        {
          "name": "E2E (real)",
          "artifacts": [
            "real-e2e-results",
            "real-e2e-results-*"
          ],
          "summaries": [
            "e2e-real/tagged/summary.json"
          ]
        }
      ],
      "laneRules": {
        "pr": {
          "channel": [
            "gate"
          ],
          "event": [
            "pull_request"
          ]
        },
        "main": {
          "channel": [
            "gate"
          ],
          "event": [
            "push",
            "workflow_dispatch"
          ]
        },
        "daily": {
          "channel": [
            "daily"
          ]
        },
        "release": {
          "channel": [
            "release"
          ]
        },
        "called": {
          "event": [
            "workflow_call"
          ]
        }
      }
    }
  ],
  "defaultWindowDays": 7
}