 "source": "workswarm process.log（agent 容器，毫秒精度；请求耗时取 [MessageHandler] 跨度，TTFT/TPOT 取云端运行时 llm_usage 记录），按 Asia/Shanghai 自然日聚合",
 "definitions": {
  "gateway": "[MessageHandler] dispatch → [MessageHandler] Stream 正常完成（total_chunks）",
  "workswarm": "[E2A][in] → run_stream_task finished",
  "overhead": "gateway − workswarm（逐请求差值取均值）",
  "ttft": "云端调用口径：模型调用开始 → 首个 Token（运行时 ttft_ms，每次模型调用一条记录）",
  "tpot": "云端调用口径：首 Token → 调用结束，按输出 Token 数（N−1）加权（运行时 tpot_ms）",
  "failure": "失败调用 = llm_call_error 事件（如 422 预算超限、408 超时）；失败率 = 失败 ÷（成功 + 失败）",
  "tokens": "成功调用的 Token 累计：llm_usage 记录 usage_metadata 的 input_tokens / output_tokens 求和",
  "first_token": "请求口径：网关受理 → 首个携带文本的 chunk（chat.delta / chat.reasoning）",
  "answer_first": "请求口径：网关受理 → 首个答案文本 chunk（chat.delta）",
  "react": "请求口径：首个文本 chunk → 首个答案文本 chunk（思考与工具阶段）",
  "tool": "工具口径：chat.tool_call → chat.tool_result（服务端适配器记录，含下发、执行与结果返回；不含端侧）",
  "uplink_send": "端侧发送口径：客户端 send → 网关收到该帧（单程，不含服务端处理）",
  "downlink_first_text": "端侧接收口径：网关发出首个文本帧 → 客户端 recv 返回（单程）",
  "downlink_terminal": "端侧接收口径：网关发出终态帧 → 客户端 recv 返回（单程）",
  "anomaly": "基线 P95 = 该日之前最近 7 个完整日的合并样本 P95（每项至少 20 个样本）；异常 = 当日样本严格大于基线 P95；异常请求 = 请求耗时超过基线 P95 的请求",
  "timeout": "llm_call_error 中含 timeout / timed out / deadline exceeded 的失败调用",
  "slow_requests": "按请求耗时排序的最慢 5% 请求；公开近 7 天内的 request_id、各阶段耗时与状态，用于在网关定位单条请求"
 },
